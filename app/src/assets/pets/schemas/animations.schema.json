{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibespace.local/schemas/pets/animations.schema.json",
  "title": "VibeSpace Pet Animations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characterId", "defaultState", "states"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "characterId": { "type": "string", "minLength": 1 },
    "defaultState": { "type": "string", "minLength": 1 },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "fps", "loop", "interruptible", "priority"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "loop": { "type": "boolean" },
        "interruptible": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "fallbackState": { "type": "string", "minLength": 1 },
        "reducedMotionState": { "type": "string", "minLength": 1 }
      }
    }
  }
}
