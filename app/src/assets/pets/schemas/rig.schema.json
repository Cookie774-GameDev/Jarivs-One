{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibespace.local/schemas/pets/rig.schema.json",
  "title": "VibeSpace Pet Pixel Rig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characterId", "logicalPixelScale", "canvas", "parts", "pivots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "characterId": { "type": "string", "minLength": 1 },
    "logicalPixelScale": { "type": "integer", "minimum": 1, "maximum": 64 },
    "canvas": { "$ref": "#/$defs/size" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    },
    "pivots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pivot" }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "texture", "pivotId", "mirrorAllowed", "optional"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "texture": { "type": "string", "minLength": 1 },
        "pivotId": { "type": "string", "minLength": 1 },
        "mirrorAllowed": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "fallbackPartId": { "type": "string", "minLength": 1 }
      }
    },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    }
  }
}
