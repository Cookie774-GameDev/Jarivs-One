# Provider keys — fill these in for local dev. Production uses host secrets.

# Disabled by default. Enable only after the matching database migrations are
# applied, the public HTTPS URL is final, and Twilio points to that exact URL.
PHONE_JARVIS_ENABLED=false
PHONE_JARVIS_PUBLIC_BASE_URL=https://phone.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when enabled. Never expose this or the service-role key to clients.
PHONE_JARVIS_TOKEN_SECRET=replace_me_with_at_least_32_random_bytes

# Supabase operator-side credentials. The service-role key is cloud-only and
# must never be embedded in the desktop app, WebView, installer, or logs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Twilio (Path A)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# LiveKit (Path C — get from livekit.io free tier or self-host)
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=secret_xxx
LIVEKIT_URL=wss://your-project.livekit.cloud

# Premium providers (Path A default stack)
DEEPGRAM_API_KEY=...
ANTHROPIC_API_KEY=<anthropic-api-key>
CARTESIA_API_KEY=...

# Free providers (Path C default stack — also fallback for Path A if user BYOK is missing)
GROQ_API_KEY=<groq-api-key>

# Legacy fallback for PHONE_JARVIS_TOKEN_SECRET. New deployments should set the
# dedicated secret above. Desktop bridge identity uses verified Supabase JWTs.
BRIDGE_TOKEN_PEPPER=replace_me_with_random_64_char_hex

# Audit log retention (days)
AUDIT_RETENTION_DAYS=30

# Cost cap per call (USD; AI hangs up if exceeded)
COST_CAP_PER_CALL=5.00

# Idle hangup (seconds of user silence before "you still there?")
IDLE_HANGUP_SECONDS=120
