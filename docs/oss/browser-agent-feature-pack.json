{
  "schemaVersion": 1,
  "id": "vibespace-browser-agent",
  "version": "1.61.1",
  "description": "An optional native signed-runtime lifecycle and Doctor bridge are implemented but remain externally blocked on production signing trust and per-platform artifacts. No Browser Agent runtime or browser binary is included in the default app.",
  "shippingStatus": "externally-blocked",
  "productionConfigurationStatus": "external-prerequisite",
  "defaultInstallerIncluded": false,
  "optionalInstallerImplemented": true,
  "separatelyRemovable": true,
  "separatelyMeasurable": true,
  "measurementStatus": "implemented-awaiting-production-artifact",
  "installerMeasurementClaimed": false,
  "updates": {
    "defaultAppUpdaterIncludesFeaturePack": false,
    "separateSignedManifestImplemented": false
  },
  "doctor": {
    "supportStatus": "implemented-external-prerequisite",
    "canDiagnoseInstalledRuntime": true,
    "canInstall": false,
    "canRepair": true,
    "configuredRepairOnly": true,
    "requiresProductionTrust": true,
    "implicitBrowserDownloadAllowed": false
  },
  "localLifecycleContract": {
    "status": "implemented-native-external-prerequisite",
    "entrypoint": "app/src-tauri/src/playwright_feature_pack_commands.rs",
    "referenceEntrypoint": "scripts/pr31-playwright-acceptance-runtime.mjs",
    "artifactSource": "caller-supplied-local-only",
    "signedManifestRequired": true,
    "downloadsAllowed": false,
    "launchesBrowser": false,
    "operations": {
      "diagnose": true,
      "installOrUpdate": true,
      "sameManifestRepair": true,
      "rollback": true,
      "measure": true,
      "uninstall": true
    },
    "productionTrustRootPinned": "compile-time-required-unconfigured",
    "nativeAtomicReparseSafe": true,
    "productDoctorIntegrated": true
  },
  "components": [
    {
      "name": "playwright-core",
      "version": "1.61.1",
      "distribution": "development-only",
      "defaultInstallerIncluded": false
    },
    {
      "name": "playwright-browser-binaries",
      "playwrightVersion": "1.61.1",
      "distribution": "not-packaged",
      "defaultInstallerIncluded": false,
      "browserRevisions": null,
      "measuredBytes": null
    }
  ],
  "excluded": [
    {
      "name": "@playwright/test",
      "reason": "development-only test wrapper"
    },
    {
      "name": "promptfoo",
      "version": "0.121.20",
      "reason": "development/CI-only evaluation runtime"
    }
  ],
  "prerequisites": [
    {
      "id": "production-signing-trust",
      "status": "missing",
      "reason": "No production Minisign public key is compiled into release builds and no production signing ceremony has supplied one."
    },
    {
      "id": "signed-feature-pack-artifact",
      "status": "missing",
      "reason": "A separately versioned and signed feature-pack artifact and update manifest do not exist."
    },
    {
      "id": "pinned-browser-revisions-and-hashes",
      "status": "missing",
      "reason": "Platform-specific browser revisions, immutable hashes, provenance, and size ceilings are not registered."
    },
    {
      "id": "native-atomic-installer",
      "status": "implemented",
      "reason": "The native fixed-app-data lifecycle is allowlisted, bounded, reparse-safe, and accepts only caller-selected local signed artifacts after compile-time trust is present."
    },
    {
      "id": "doctor-verification-and-repair",
      "status": "implemented",
      "reason": "Product Doctor diagnoses the native lifecycle and permits only configured same-manifest repair; it never installs an absent runtime or downloads a browser."
    },
    {
      "id": "uninstall-rollback-measurement",
      "status": "implemented",
      "reason": "Native commands expose state-bound uninstall, verified rollback, and signed installed-size measurement while refusing untrusted or tampered state."
    }
  ]
}
