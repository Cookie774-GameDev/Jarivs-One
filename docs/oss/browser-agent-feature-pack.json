{
  "schemaVersion": 1,
  "id": "vibespace-browser-agent",
  "version": "1.61.1",
  "description": "Development-only Playwright automation metadata plus a repository-only offline lifecycle contract. No Browser Agent runtime or browser binary is shipped.",
  "shippingStatus": "not-implemented",
  "defaultInstallerIncluded": false,
  "optionalInstallerImplemented": false,
  "separatelyRemovable": false,
  "separatelyMeasurable": false,
  "measurementStatus": "not-applicable-unshipped",
  "installerMeasurementClaimed": false,
  "updates": {
    "defaultAppUpdaterIncludesFeaturePack": false,
    "separateSignedManifestImplemented": false
  },
  "doctor": {
    "supportStatus": "unavailable",
    "canDiagnoseInstalledRuntime": false,
    "canInstall": false,
    "canRepair": false,
    "implicitBrowserDownloadAllowed": false
  },
  "localLifecycleContract": {
    "status": "implemented-unintegrated",
    "entrypoint": "scripts/pr31-playwright-acceptance-runtime.mjs",
    "artifactSource": "caller-supplied-local-only",
    "signedManifestRequired": true,
    "downloadsAllowed": false,
    "launchesBrowser": false,
    "operations": {
      "diagnose": true,
      "installOrUpdate": true,
      "sameManifestRepair": true,
      "rollback": true,
      "measure": true,
      "uninstall": true
    },
    "productionTrustRootPinned": false,
    "nativeAtomicReparseSafe": false,
    "productDoctorIntegrated": false
  },
  "components": [
    {
      "name": "playwright-core",
      "version": "1.61.1",
      "distribution": "development-only",
      "defaultInstallerIncluded": false
    },
    {
      "name": "playwright-browser-binaries",
      "playwrightVersion": "1.61.1",
      "distribution": "not-packaged",
      "defaultInstallerIncluded": false,
      "browserRevisions": null,
      "measuredBytes": null
    }
  ],
  "excluded": [
    {
      "name": "@playwright/test",
      "reason": "development-only test wrapper"
    },
    {
      "name": "promptfoo",
      "version": "0.121.20",
      "reason": "development/CI-only evaluation runtime"
    }
  ],
  "prerequisites": [
    {
      "id": "signed-feature-pack-artifact",
      "status": "missing",
      "reason": "A separately versioned and signed feature-pack artifact and update manifest do not exist."
    },
    {
      "id": "pinned-browser-revisions-and-hashes",
      "status": "missing",
      "reason": "Platform-specific browser revisions, immutable hashes, provenance, and size ceilings are not registered."
    },
    {
      "id": "native-atomic-installer",
      "status": "partial",
      "reason": "The repository-only offline lifecycle stages verified files and switches local state, but no production-key-pinned native allowlisted or reparse-safe installation boundary exists."
    },
    {
      "id": "doctor-verification-and-repair",
      "status": "partial",
      "reason": "The repository-only lifecycle diagnoses exact signed hashes and permits same-manifest offline repair, but the product Doctor has no Playwright integration or install authority."
    },
    {
      "id": "uninstall-rollback-measurement",
      "status": "partial",
      "reason": "The repository-only lifecycle supports state-bound uninstall, verified rollback, and signed installed-size measurement, but native product integration and official-app acceptance evidence do not exist."
    }
  ]
}
