{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibespace.local/sakura/windows-overlays.schema.json",
  "title": "VibeSpace Sakura Windows and Overlays Coverage Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestKind",
    "predecessorCommit",
    "sourceAuthority",
    "sourceCommit",
    "finalRouteIds",
    "settingsTabIds",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestKind": { "const": "windows-overlays" },
    "predecessorCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "sourceAuthority": { "const": "tests/visual/monochrome/route-manifest.ts" },
    "sourceCommit": { "type": "string", "minLength": 7 },
    "finalRouteIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "settingsTabIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "entries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "./routes.schema.json#/$defs/entry" },
          {
            "properties": {
              "kind": { "enum": ["overlay", "detached", "native"] }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
