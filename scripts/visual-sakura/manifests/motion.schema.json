{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibespace.local/schemas/sakura-motion.v1.json",
  "title": "VibeSpace Sakura motion authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "sourceRoot", "policies", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "const": "vibespace.sakura.motion.v1"
    },
    "sourceRoot": {
      "const": "app/src"
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorThemes", "sakura", "reducedMotion", "layout"],
      "properties": {
        "priorThemes": {
          "const": "exact-legacy-transition-object"
        },
        "sakura": {
          "const": "220ms-calm-no-overshoot-tween"
        },
        "reducedMotion": {
          "const": "zero-duration"
        },
        "layout": {
          "const": "disabled-or-zero-duration-for-sakura-and-reduced-motion"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "line",
          "occurrence",
          "locator",
          "role",
          "legacy",
          "consumers",
          "sakuraReachable",
          "ownerLane",
          "sakuraPolicy",
          "reducedMotionPolicy",
          "binding",
          "layoutAffecting",
          "layoutPolicy",
          "semanticException"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^app/src/.+\\.(ts|tsx)$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "string",
            "minLength": 3
          },
          "role": {
            "type": "string",
            "minLength": 8
          },
          "legacy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "stiffness", "damping"],
            "properties": {
              "type": {
                "const": "spring"
              },
              "stiffness": {
                "type": "number"
              },
              "damping": {
                "type": "number"
              },
              "mass": {
                "type": "number"
              }
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^app/src/.+\\.(ts|tsx)#.+$"
            }
          },
          "sakuraReachable": {
            "const": true
          },
          "ownerLane": {
            "type": "string",
            "minLength": 3
          },
          "sakuraPolicy": {
            "enum": ["shared-theme-policy", "semantic-exception"]
          },
          "reducedMotionPolicy": {
            "const": "zero-duration"
          },
          "binding": {
            "type": ["string", "null"],
            "enum": [
              "useThemeMotionTransition",
              "useThemeLayoutTransition",
              "consumer-useThemeMotionTransition",
              null
            ]
          },
          "layoutAffecting": {
            "type": "boolean"
          },
          "layoutPolicy": {
            "enum": ["disabled", "instant", "not-applicable"]
          },
          "semanticException": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["reviewId", "rationale"],
                "properties": {
                  "reviewId": {
                    "type": "string",
                    "pattern": "^SAK-MOTION-EXCEPTION-[0-9]{3}$"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 24
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
