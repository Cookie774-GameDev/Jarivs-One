{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibespace.local/sakura/routes.schema.json",
  "title": "VibeSpace Sakura Route Coverage Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestKind",
    "predecessorCommit",
    "sourceAuthority",
    "sourceCommit",
    "finalRouteIds",
    "settingsTabIds",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestKind": { "const": "routes" },
    "predecessorCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "sourceAuthority": { "const": "tests/visual/monochrome/route-manifest.ts" },
    "sourceCommit": { "type": "string", "minLength": 7 },
    "finalRouteIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "settingsTabIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "routeId",
        "auditStatus",
        "availability",
        "owner",
        "requirements",
        "sourcePaths",
        "writerPaths",
        "testPaths",
        "behaviorCommands",
        "viewports",
        "zoom",
        "motion",
        "baselineCaptureIds",
        "logicalLock",
        "fileLockPaths",
        "sharedReadOnlyPaths",
        "exclusions",
        "unavailableReason"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "route",
            "settings",
            "access",
            "embedded",
            "development",
            "future",
            "overlay",
            "detached",
            "native"
          ]
        },
        "routeId": { "type": ["string", "null"] },
        "auditStatus": { "type": "string" },
        "availability": { "type": "string" },
        "owner": { "pattern": "^SK(4|5|7[A-G]|9)$" },
        "requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sourcePaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "writerPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "testPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "behaviorCommands": { "type": "array", "items": { "type": "string" } },
        "viewports": { "type": "array", "items": { "type": "string" } },
        "zoom": { "type": "array", "items": { "type": "string" } },
        "motion": { "type": "array", "items": { "type": "string" } },
        "baselineCaptureIds": { "type": "array", "items": { "type": "string" } },
        "logicalLock": { "type": "string", "pattern": "^sakura:" },
        "fileLockPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sharedReadOnlyPaths": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "exclusions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "unavailableReason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
