{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibespace-ai-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,

  "triggers": {
    "crons": ["7 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibespace-news",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "CORS_ORIGIN": "*",
    "OFFICIAL_FEEDS": "[]",
    "REDDIT_SUBREDDITS": "LocalLLaMA,MachineLearning,OpenAI,ClaudeAI",
    "YOUTUBE_CHANNELS": "[]",
    "X_QUERY": "(AI OR model OR LLM) -is:retweet lang:en",
    "X_OFFICIAL_USERNAMES": "",
    "AI_ENABLED": "false",
    "AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "AI_MAX_ITEMS_PER_RUN": "4",
    "MAX_ITEMS_PER_RUN": "40"
  }
}
