{
  "name": "@vibespace/promo-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "30-second VibeSpace product film built with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx VibeSpacePromo out/vibespace-promo.mp4",
    "still": "remotion still src/index.tsx VibeSpacePromo out/vibespace-promo-poster.png --frame=810",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.489",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
